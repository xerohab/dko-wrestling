{
  "name": "Article",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Article headline"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug"
    },
    "body": {
      "type": "string",
      "description": "Rich text HTML body"
    },
    "excerpt": {
      "type": "string",
      "description": "Short excerpt/summary"
    },
    "category": {
      "type": "string",
      "description": "Primary category name (legacy)"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of category names"
    },
    "featured_image": {
      "type": "string",
      "description": "Featured image URL"
    },
    "author_name": {
      "type": "string",
      "description": "Author display name"
    },
    "author_email": {
      "type": "string",
      "description": "Author email"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    },
    "published_date": {
      "type": "string",
      "description": "ISO date of publication"
    },
    "seo_title": {
      "type": "string",
      "description": "SEO meta title (defaults to title)"
    },
    "seo_description": {
      "type": "string",
      "description": "SEO meta description"
    },
    "tweeted": {
      "type": "boolean",
      "default": false,
      "description": "Whether auto-tweet was sent"
    },
    "is_paywalled": {
      "type": "boolean",
      "default": false,
      "description": "Lock full body behind premium subscription"
    }
  },
  "required": [
    "title",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    }
  }
}