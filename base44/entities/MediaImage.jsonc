{
  "name": "MediaImage",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Image title or alt text"
    },
    "url": {
      "type": "string",
      "description": "Public image URL"
    },
    "uploaded_by": {
      "type": "string",
      "description": "Uploader email"
    },
    "file_size": {
      "type": "string",
      "description": "Human-readable file size"
    }
  },
  "required": [
    "url"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "editor"
          }
        }
      ]
    }
  }
}