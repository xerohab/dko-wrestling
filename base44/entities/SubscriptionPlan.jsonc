{
  "name": "SubscriptionPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Plan name e.g. Gold Member"
    },
    "description": {
      "type": "string",
      "description": "What's included"
    },
    "price": {
      "type": "number",
      "description": "Price in GBP"
    },
    "interval": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly",
        "one_time"
      ],
      "default": "monthly",
      "description": "Billing interval \u2014 one_time = lifetime / single payment"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of features"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "highlight": {
      "type": "boolean",
      "default": false,
      "description": "Featured/most popular plan"
    },
    "paypal_plan_id": {
      "type": "string",
      "description": "PayPal subscription plan ID"
    },
    "grants_paywall_access": {
      "type": "boolean",
      "default": false,
      "description": "Subscribers to this plan can read paywalled articles"
    },
    "is_hidden": {
      "type": "boolean",
      "default": false,
      "description": "Hidden from public pricing page \u2014 staff-only plan (e.g. Lifetime)"
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}