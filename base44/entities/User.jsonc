{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "editor",
        "user"
      ],
      "default": "user"
    },
    "display_name": {
      "type": "string",
      "description": "Public display name"
    },
    "avatar": {
      "type": "string",
      "description": "Profile picture URL"
    },
    "motto": {
      "type": "string",
      "description": "Personal motto or bio tagline"
    },
    "bio": {
      "type": "string",
      "description": "Short biography"
    },
    "twitter_handle": {
      "type": "string",
      "description": "Twitter/X handle without @"
    },
    "instagram_handle": {
      "type": "string",
      "description": "Instagram handle without @"
    },
    "location": {
      "type": "string",
      "description": "User location"
    },
    "website": {
      "type": "string",
      "description": "Personal website URL"
    },
    "favorite_wrestler": {
      "type": "string",
      "description": "Favourite wrestler or superstar"
    },
    "favorite_show": {
      "type": "string",
      "description": "Favourite wrestling show or promotion"
    },
    "notify_new_articles": {
      "type": "boolean",
      "default": true,
      "description": "Email notifications for new articles"
    }
  }
}