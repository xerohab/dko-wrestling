{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category display name"
    },
    "slug": {
      "type": "string",
      "description": "URL slug for category"
    },
    "color": {
      "type": "string",
      "default": "#CC0000",
      "description": "Badge color"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "parent_id": {
      "type": "string",
      "description": "Parent category ID (null = top level)"
    },
    "level": {
      "type": "number",
      "default": 0,
      "description": "0=top level, 1=sub, 2=sub-sub etc"
    },
    "description": {
      "type": "string",
      "description": "Optional short description"
    },
    "link_url": {
      "type": "string",
      "description": "Optional external link URL \u2014 if set, clicking navigates to this URL instead of category page"
    },
    "usage": {
      "type": "string",
      "enum": [
        "menu",
        "article",
        "both"
      ],
      "default": "both",
      "description": "menu = nav only, article = article tagging only, both = everywhere"
    }
  },
  "required": [
    "name",
    "slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}